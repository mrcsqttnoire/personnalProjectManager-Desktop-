<!-- C++Builder XML Project -->
<PROJECT>
  <MACROS>
    <VERSION value="BCB.06.00"/>
    <PROJECT value="personal_project_manager.exe"/>
    <OBJFILES value="personal_project_manager.obj Unit1.obj Unit2.obj Unit3.obj Unit4.obj 
